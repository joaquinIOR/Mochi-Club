# Environment variables for Mochi Club

# PostgreSQL Database (Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-SUPABASE-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Mercado Pago Checkout Pro
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-..."
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY="APP_USR-..."
MERCADO_PAGO_WEBHOOK_SECRET="your-webhook-secret"

# Resend (Email Services)
RESEND_API_KEY="re_..."
EMAIL_FROM="Mochi Club <hola@mochiclub.cl>"

# Upstash Rate Limiting
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
